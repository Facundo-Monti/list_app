# Application
NODE_ENV=development
APP_NAME=lista-app
APP_PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=lista_app
DB_SYNCHRONIZE=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_REFRESH_EXPIRATION=30d

# Frontend
ANGULAR_PORT=4200
API_URL=http://localhost:3000

# Email (opcional para después)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Logs
LOG_LEVEL=debug